#include <nuttx/config.h>

/****************************************************************************
 * vendor/artinchip/boards/d13x-hengshan-pi/scripts/ld.script
 *
 * D13x Hengshan Pi 链接脚本
 * 地址来源: luban-lite aic_soc.h + D13x User Manual
 *
 ****************************************************************************/

MEMORY
{
  /* PBP initializes the board's 8 MiB PSRAM before tinySPL loads this image. */

  psram (rwx) : ORIGIN = 0x40000000, LENGTH = 8M
}

OUTPUT_ARCH(riscv)
ENTRY(__start)

SECTIONS
{
    .text : {
        _stext = ABSOLUTE(.);
        *(.vectors)
        *(.text .text.*)
        *(.fixup)
        *(.gnu.warning)
        *(.rodata .rodata.* .srodata .srodata.*)
        *(.gnu.linkonce.t.*)
        *(.got)
        *(.gcc_except_table .gcc_except_table.*)
        *(.eh_frame .eh_frame.*)
        *(.gnu.linkonce.r.*)
        _etext = ABSOLUTE(.);
    } > psram

    .init_section : {
        _sinit = ABSOLUTE(.);
        KEEP(*(SORT_BY_INIT_PRIORITY(.init_array.*) SORT_BY_INIT_PRIORITY(.ctors.*)))
        KEEP(*(.init_array EXCLUDE_FILE(*crtbegin.o *crtbegin?.o *crtend.o *crtend?.o) .ctors))
        _einit = ABSOLUTE(.);
    } > psram

    .tdata : {
        _stdata = ABSOLUTE(.);
        *(.tdata .tdata.* .gnu.linkonce.td.*);
        _etdata = ABSOLUTE(.);
    } > psram

    .tbss : {
        _stbss = ABSOLUTE(.);
        *(.tbss .tbss.* .gnu.linkonce.tb.* .tcommon);
        _etbss = ABSOLUTE(.);
    } > psram

    _eronly = ABSOLUTE(.);

    .data : {
        _sdata = ABSOLUTE(.);
        *(.data .data.* .sdata .sdata.*)
        *(.gnu.linkonce.d.*)
        CONSTRUCTORS
        . = ALIGN(4);
        _edata = ABSOLUTE(.);
    } > psram

    .bss : {
        _sbss = ABSOLUTE(.);
        *(.bss .bss.* .sbss .sbss.*)
        *(.gnu.linkonce.b.*)
        *(COMMON)
        . = ALIGN(4);
        _ebss = ABSOLUTE(.);
    } > psram

    /* Reserve the initial NuttX IDLE stack so the PSRAM heap cannot overlap
     * the stack used between __start and scheduler initialization.
     */

    .idle_stack (NOLOAD) : {
        . = ALIGN(16);
        _sidle_stack = ABSOLUTE(.);
        . += CONFIG_IDLETHREAD_STACKSIZE;
        . = ALIGN(16);
        _eidle_stack = ABSOLUTE(.);
    } > psram

    /* GP 寄存器符号 (来源: luban-lite) */

    PROVIDE(__global_pointer$ = _sdata + 0x800);

    /* 调试段 */

    .stab 0 : { *(.stab) }
    .stabstr 0 : { *(.stabstr) }
    .stab.excl 0 : { *(.stab.excl) }
    .stab.exclstr 0 : { *(.stab.exclstr) }
    .stab.index 0 : { *(.stab.index) }
    .stab.indexstr 0 : { *(.stab.indexstr) }
    .comment 0 : { *(.comment) }
    .debug_abbrev 0 : { *(.debug_abbrev) }
    .debug_info 0 : { *(.debug_info) }
    .debug_line 0 : { *(.debug_line) }
    .debug_pubnames 0 : { *(.debug_pubnames) }
    .debug_aranges 0 : { *(.debug_aranges) }
}
